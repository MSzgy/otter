{
  "name": "otter-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Otter desktop companion",
  "author": "Otter contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test electron/*.test.cjs",
    "test:e2e": "npm run build && node scripts/smoke.cjs",
    "package": "npm run build && electron-builder --dir",
    "bundle:backend": "python3 scripts/build_backend.py"
  },
  "build": {
    "appId": "dev.otter.desktop",
    "productName": "Otter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/otter-runtime",
        "to": "backend/otter-runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "在你开启浏览器感知后，Otter 读取当前标签页的标题和网址，仅在本机展示，不读取网页正文。"
      }
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
